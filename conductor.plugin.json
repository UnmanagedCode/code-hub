{
  "id": "code-hub",
  "name": "Code Hub",
  "version": "0.1.0",
  "pluginApi": 1,
  "backend": {
    "start": "npm start",
    "healthPath": "/api/health"
  },
  "frontend": {
    "path": "/",
    "navLabel": "Code Hub"
  },
  "mcp": {
    "endpoint": "/api/mcp",
    "scope": "project",
    "tools": [
      {
        "name": "list_apps",
        "description": "Every discoverable app (main checkouts and worktrees) with its status, port, URLs, git state, share, stored settings and, for a crashed app, its retained output and log path; plus cloudflared/tailscale availability, Funnel port occupancy and hub settings.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cloudflaredAvailable",
            "tailscaleAvailable",
            "funnelPorts",
            "hubSettings",
            "apps"
          ],
          "properties": {
            "cloudflaredAvailable": {
              "type": "boolean"
            },
            "tailscaleAvailable": {
              "type": "boolean"
            },
            "funnelPorts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "port",
                  "holder"
                ],
                "properties": {
                  "port": {
                    "type": "integer"
                  },
                  "holder": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "hubSettings": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bridgeFallback"
              ],
              "properties": {
                "bridgeFallback": {
                  "type": "boolean"
                }
              }
            },
            "apps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "project",
                  "name",
                  "path",
                  "isWorktree",
                  "branch",
                  "status",
                  "currentSha",
                  "lastCommitAt",
                  "outOfDate",
                  "sourceMissing",
                  "routes",
                  "settings",
                  "manifestPort",
                  "autoShareStatus",
                  "autoShareError",
                  "autoStartError",
                  "tunnel",
                  "error",
                  "manifestError",
                  "alwaysOn",
                  "logFile",
                  "output",
                  "outputTruncated"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "project": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "isWorktree": {
                    "type": "boolean"
                  },
                  "branch": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "enum": [
                      "stopped",
                      "starting",
                      "ready",
                      "running",
                      "crashed"
                    ]
                  },
                  "port": {
                    "type": "integer"
                  },
                  "urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "startedSha": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "currentSha": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "lastCommitAt": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "outOfDate": {
                    "type": "boolean"
                  },
                  "sourceMissing": {
                    "type": "boolean"
                  },
                  "routes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "path",
                        "urls"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "path": {
                          "type": "string"
                        },
                        "urls": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "settings": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "username",
                      "hasPassword",
                      "autoStart",
                      "autoShare",
                      "port"
                    ],
                    "properties": {
                      "username": {
                        "description": "Stored default share username. Taken from the hand-editable app-settings.json without validation, so any JSON value can appear."
                      },
                      "hasPassword": {
                        "type": "boolean"
                      },
                      "autoStart": {
                        "type": "boolean"
                      },
                      "autoShare": {
                        "description": "Stored auto-share options ({mode, auth, tls?, funnelPort?}; a tailscale entry always carries funnelPort, defaulted when unset) or null. Taken from the hand-editable app-settings.json without validation, so any JSON value can appear."
                      },
                      "port": {
                        "description": "Stored fixed port or null. Taken from the hand-editable app-settings.json without validation, so any JSON value can appear. start_app on a main checkout uses an integer in the fixed-port range, or a canonical integer string (String(Number(v)) === v) in it as that integer, and refuses anything else with SETTINGS_INVALID; a worktree ignores the stored port."
                      }
                    }
                  },
                  "manifestPort": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "autoShareStatus": {
                    "enum": [
                      "pending",
                      "failed",
                      null
                    ]
                  },
                  "autoShareError": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "autoStartError": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "tunnel": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                      "url",
                      "kind",
                      "urls",
                      "proxyPort",
                      "funnelPort",
                      "fixedPortFallback",
                      "fixedPortHolder",
                      "relay",
                      "containerInternal",
                      "auth",
                      "tls",
                      "username",
                      "password",
                      "passwordIsDefault"
                    ],
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "lan",
                          "tunnel",
                          "tailscale"
                        ]
                      },
                      "urls": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "items": {
                          "type": "string"
                        }
                      },
                      "proxyPort": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "funnelPort": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "fixedPortFallback": {
                        "type": "boolean"
                      },
                      "fixedPortHolder": {
                        "enum": [
                          "app",
                          "other",
                          "unknown",
                          null
                        ]
                      },
                      "relay": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "additionalProperties": true,
                        "properties": {
                          "state": {
                            "type": "string"
                          },
                          "error": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "port": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "requestedPort": {
                            "type": "integer"
                          },
                          "portFallback": {
                            "type": "boolean"
                          },
                          "recovery": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "description": "Host-relay forward of a LAN share, as reported by the relay; null when none."
                      },
                      "containerInternal": {
                        "type": "boolean"
                      },
                      "auth": {
                        "type": "boolean"
                      },
                      "tls": {
                        "type": "boolean"
                      },
                      "username": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "password": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "passwordIsDefault": {
                        "type": "boolean"
                      },
                      "authUrl": {
                        "type": "string"
                      },
                      "qrSvg": {
                        "type": "string"
                      }
                    }
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Why the app is not running: a crashed app's reason line (null when it reached ready and then exited on its own, which leaves no reason), else a stopped app's manifestError."
                  },
                  "manifestError": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "alwaysOn": {
                    "type": "boolean"
                  },
                  "source": {
                    "enum": [
                      "manifest",
                      "registry",
                      "memory"
                    ]
                  },
                  "logFile": {
                    "type": "string",
                    "description": "Where code-hub writes this app's output when it starts it; may not exist yet."
                  },
                  "output": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "A crashed app's retained output (the whole in-memory ring); null unless status is crashed."
                  },
                  "outputTruncated": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "True when older output was dropped from the in-memory ring before `output`; that older output may still be in logFile, subject to its rotation cap. Null when output is null."
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "start_app",
        "description": "Start an app by id. Answers once the process is spawned, with its pid, port and URLs. Readiness is not confirmed: the app may already have crashed, and list_apps reports the settled status.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "project",
            "path",
            "isWorktree",
            "branch",
            "port",
            "fixedPort",
            "startedSha",
            "startedAt",
            "tunnel",
            "urls"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "isWorktree": {
              "type": "boolean"
            },
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "pid": {
              "type": "integer"
            },
            "pgid": {
              "type": "integer"
            },
            "port": {
              "type": "integer"
            },
            "fixedPort": {
              "type": [
                "integer",
                "null"
              ]
            },
            "startedSha": {
              "type": [
                "string",
                "null"
              ]
            },
            "startedAt": {
              "type": "string"
            },
            "tunnel": {
              "type": "null"
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      {
        "name": "stop_app",
        "description": "Stop a running app by id, tearing down any share it has.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "const": "stopped"
            }
          }
        }
      },
      {
        "name": "register_app",
        "description": "Register a project directory or worktree checkout that has no .hub.json as a startable app (machine-local, written to registrations.json). `id` is the app id: a project's directory basename, or `<project>:<key>` for a worktree. `:` is reserved for that qualifier, so an id containing one is only ever resolved as a worktree — a project directory whose name contains `:` cannot be registered (or served) at all. Rejected if the directory already has a .hub.json. An optional fixed `port` (1024-65535) pins the app to that port on its default checkout instead of an allocated free one; worktrees ignore it and always get a free port. Multi-route apps (a routes array) can't be expressed in this schema — register those by hand-editing registrations.json directly. Answers with the registered app's discovery record (id, path, manifest, source).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            },
            "healthPath": {
              "type": "string"
            },
            "readyWhen": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          },
          "required": [
            "id",
            "start"
          ]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "project",
            "path",
            "isWorktree",
            "branch",
            "manifest",
            "manifestError",
            "source"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "isWorktree": {
              "type": "boolean"
            },
            "branch": {
              "type": "null"
            },
            "manifest": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "start",
                "name",
                "healthPath",
                "readyWhen",
                "port",
                "routes"
              ],
              "properties": {
                "start": {
                  "type": "string"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "healthPath": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "readyWhen": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "port": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "routes": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "path"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "manifestError": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "enum": [
                "manifest",
                "registry",
                "memory"
              ]
            }
          }
        }
      },
      {
        "name": "unregister_app",
        "description": "Remove a machine-local registration for a project or worktree (from registrations.json), by app id. Has no effect on one with its own .hub.json.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "registered"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "registered": {
              "const": false
            }
          }
        }
      }
    ]
  }
}
