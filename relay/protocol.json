{
  "protocolVersion": 2,
  "rendezvous": { "dir": "relay", "hubFile": "relay.json", "relayFile": "host.json" },
  "macLabels": { "hub": "code-hub-relay/2 hub", "relay": "code-hub-relay/2 relay" },
  "frames": {
    "hello": "hello", "auth": "auth", "welcome": "welcome", "error": "error",
    "ports": "ports", "status": "status", "incoming": "incoming",
    "ping": "ping", "pong": "pong"
  },
  "roles": { "control": "control", "data": "data" },
  "scopes": { "lan": "lan", "loopback": "loopback" },
  "port": { "min": 1024, "max": 65535 },
  "minSecretLength": 32,
  "nonceBytes": 32,
  "maxAddresses": 16,
  "maxPorts": 64,
  "maxFrameBytes": 16384,
  "maxRendezvousBytes": 4096,
  "maxPendingHandshakes": 32,
  "maxHubHandshakes": 8,
  "maxIncomingPerPort": 32,
  "maxIncomingTotal": 128,
  "handshakeTimeoutMs": 3000,
  "pingIntervalMs": 5000,
  "keepaliveTimeoutMs": 15000,
  "errorCodes": {
    "authFailed": "auth_failed", "versionMismatch": "version_mismatch", "noSecret": "no_secret",
    "badFrame": "bad_frame", "staleSession": "stale_session", "unknownConn": "unknown_conn",
    "tooManyPorts": "too_many_ports", "noLanAddress": "no_lan_address", "bindFailed": "bind_failed"
  }
}
